# OpenAI-compatible LLM endpoint. DeepSeek works with this shape.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
# Required before source snippets are sent to a non-local LLM endpoint.
LLM_EXTERNAL_UPLOAD_ALLOWED=false
# Optional DeepSeek/OpenAI-compatible structured stages.
LLM_SEMANTIC_REVIEW_ENABLED=false
LLM_ANSWER_QA_ENABLED=false
LLM_REVIEW_MAX_TOKENS=2048
LLM_REVIEW_SLEEP_SECONDS=0
LLM_DATA_REVIEW_LIMIT=12

# Retrieval/runtime defaults.
BAXTER_RAG_ROOT=.
BAXTER_RAG_COLLECTION=ic_baxter
BAXTER_RAG_TOP_K=8
BAXTER_RAG_MAX_CONTEXT_CHARS=9000
BAXTER_RAG_LLM_ENRICHMENT_ENABLED=false
BAXTER_RAG_EMBEDDING_MODEL=local_hash_bm25
BAXTER_RAG_RECOMMENDED_EMBEDDING_MODEL=BAAI/bge-m3
BAXTER_RAG_RERANK_ENABLED=false
BAXTER_RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
APP_HOST=127.0.0.1
APP_PORT=8090

# Optional Qdrant. The app always writes a local hybrid index first.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ic_baxter
QDRANT_ENABLED=false

# Optional MinerU wrapper.
MINERU_EXECUTABLE=mineru
MINERU_ENABLED=false
MINERU_API_URL=
MINERU_TIMEOUT_SECONDS=1800

# Optional page-level OCR fallback. Disabled by default because it needs a
# local PaddleOCR runtime plus a PDF page renderer.
PADDLEOCR_EXECUTABLE=paddleocr
PADDLEOCR_ENABLED=false
PADDLEOCR_RUN=false

# Optional Hyper-Extract structured extraction. Keep external upload disabled
# unless you explicitly allow sending retrieved snippets to the configured LLM.
HYPER_EXTRACT_EXECUTABLE=he
HYPER_EXTRACT_ENABLED=false
HYPER_EXTRACT_ALLOW_EXTERNAL=false

# Optional Apodex/OpenAI-compatible validator.
APODEX_ENABLED=false
APODEX_ALLOW_EXTERNAL=false
APODEX_BASE_URL=http://127.0.0.1:8000/v1
APODEX_API_KEY=
APODEX_MODEL=apodex/Apodex-1.0-mini
APODEX_TIMEOUT_SECONDS=30
APODEX_MODEL_PATH=tools/models/apodex-1.0-mini-q4_k_m/apodex-1.0-mini-q4_k_m.gguf
APODEX_LLAMA_SERVER=tools/llama.cpp/b9743-cpu-x64/llama-server.exe

# Optional Apodex semantic Markdown review. This saves patch proposals only;
# it does not modify normalized Markdown automatically.
APODEX_SEMANTIC_REVIEW_ENABLED=false
APODEX_REVIEW_MAX_TOKENS=2048
APODEX_REVIEW_SLEEP_SECONDS=0
